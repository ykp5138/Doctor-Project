# Optional: send only checkmark/X feedback to a shared receiver.
# Copy to frontend/.env.local and restart Vite after changing these settings.
# Add the cloud collector's write credential, then restart Vite.
# Empty both values only when you intentionally want local feedback storage.
FEEDBACK_API_URL=https://doctor-feedback-collector-patel.handyfrost65.chatgpt.site
FEEDBACK_API_TOKEN=

# Keep the token out of Git. Never rename it to VITE_FEEDBACK_API_TOKEN:
# VITE_ variables can be exposed in the browser bundle.
